# MongoDB connection string (database name is taken from the path, default "hexplorer")
DATABASE_URL=mongodb://user:password@localhost:27017/hexplorer?authSource=hexplorer
# base folder: relative data-folder paths resolve here
DATA_FOLDER=./data
# where SSH remotes are mounted with sshfs (default: $DATA_FOLDER/mounts)
# MOUNTS_FOLDER=./data/mounts
# encrypts remote passwords stored in MongoDB (required for password logins): openssl rand -hex 32
APP_SECRET=
