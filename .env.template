# MongoDB connection string (database name is taken from the path, default "hexplorer")
DATABASE_URL=mongodb://user:password@localhost:27017/hexplorer?authSource=hexplorer
# base folder: relative data-folder paths resolve here
DATA_FOLDER=./data
# where SSH remotes are mounted with sshfs (default: $DATA_FOLDER/mounts)
# MOUNTS_FOLDER=./data/mounts
# encrypts remote passwords stored in MongoDB (required for password logins): openssl rand -hex 32
APP_SECRET=

# --- sign in (better-auth) ---
# URL you open the app with; passkeys are bound to this host name (needs https,
# except on localhost)
BETTER_AUTH_URL=http://localhost:3000
# random secret for sessions (falls back to APP_SECRET): openssl rand -hex 32
BETTER_AUTH_SECRET=
# extra origins the app is reached from, comma separated (e.g. http://192.168.1.10:3000)
BETTER_AUTH_TRUSTED_ORIGINS=
# optional: URL the middleware uses to reach this server itself (default: request origin)
AUTH_INTERNAL_URL=
